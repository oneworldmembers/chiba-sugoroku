{
  "name": "chiba-sugoroku",
  "version": "0.1.0",
  "description": "千葉県の町名単位マスで遊ぶ、すごろく型の物件経営ボードゲーム",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "board:sample": "tsx scripts/build-board.ts --input data/towns.sample.csv --out public/boards/chiba-sample.json --id chiba-sample --name \"千葉県サンプル盤\" --start 12101:富士見",
    "board:build": "tsx scripts/build-board.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
